PORT=3001
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES=8h
MFA_ENCRYPTION_KEY=replace-with-64-random-hex-characters
GOOGLE_CLIENT_ID=
ALLOWED_GOOGLE_EMAILS=
ALLOWED_ORIGINS=https://kamilstore.store,https://www.kamilstore.store
PUBLIC_API_URL=https://api.kamilstore.store
DB_POOL_MAX=10
JSON_BODY_LIMIT=20mb

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kamil-dashboard-private
R2_JURISDICTION=default
